{
  "name": "Quick CLI",
  "description": "A terminal-like popup to run web aliases and OS commands via native messaging.",
  "version": "1.0.0",
  "manifest_version": 3,
  "key": "",
  "permissions": [
    "storage",
    "tabs",
    "nativeMessaging"
  ],

  "action": {
    "default_title": "Quick CLI",
    "default_popup": "popup.html"
  },

  "background": {
    "service_worker": "background.js"
  }
}
